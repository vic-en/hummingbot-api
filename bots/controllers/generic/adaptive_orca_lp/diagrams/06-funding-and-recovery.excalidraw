    {
      "id": "n1",
      "type": "text",
      "x": 60,
      "y": 662,
      "width": 600,
      "height": 37.5,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2114751911,
      "version": 1,
      "versionNonce": 100046709,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788113832557,
      "link": null,
      "locked": false,
      "text": "Recovery runs before any capital is deployed, so a restart can never stack a\nsecond position. A failed query leaves the flag unset and retries next cycle.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recovery runs before any capital is deployed, so a restart can never stack a\nsecond position. A failed query leaves the flag unset and retries next cycle.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "n2",
      "type": "text",
      "x": 760,
      "y": 722,
      "width": 620,
      "height": 56.25,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2116259597,
      "version": 1,
      "versionNonce": 303440164,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788113832557,
      "link": null,
      "locked": false,
      "text": "A re-centring CLMM position converts toward one token on every move, so the\nwallet mix drifts away from what the next range needs. The swap never eats the\nbase reserved for the position plus the chain's native reserve (0.1 SOL).",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A re-centring CLMM position converts toward one token on every move, so the\nwallet mix drifts away from what the next range needs. The swap never eats the\nbase reserved for the position plus the chain's native reserve (0.1 SOL).",
      "lineHeight": 1.25,
      "autoResize": true
    }
  ],
