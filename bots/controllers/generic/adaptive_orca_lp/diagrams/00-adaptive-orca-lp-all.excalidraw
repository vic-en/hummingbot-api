    {
      "id": "03-rebalance-gates_n1",
      "type": "text",
      "x": 60,
      "y": 3398,
      "width": 900,
      "height": 37.5,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1655921530,
      "version": 1,
      "versionNonce": 2079364917,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788113832557,
      "link": null,
      "locked": false,
      "text": "Reaching the edge is necessary but never sufficient. All four gates must pass;\nany one of them holds the position where it is.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reaching the edge is necessary but never sufficient. All four gates must pass;\nany one of them holds the position where it is.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "03-rebalance-gates_n2",
      "type": "text",
      "x": 60,
      "y": 3458,
      "width": 900,
      "height": 37.5,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1968251080,
      "version": 1,
      "versionNonce": 972791972,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788113832557,
      "link": null,
      "locked": false,
      "text": "The cooldown clock starts when a rebalance is APPROVED, so a rebalance that\nfails on-chain still consumes it and cannot spin.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The cooldown clock starts when a rebalance is APPROVED, so a rebalance that\nfails on-chain still consumes it and cannot spin.",
      "lineHeight": 1.25,
      "autoResize": true
    },
