      "boundElements": [],
      "updated": 1788113832557,
      "link": null,
      "locked": false,
      "text": "A failed rebalance never reports ACTIVE. If the close succeeds and the reopen fails,\nthe controller clears its position state, reports ERROR, and retries after an\nescalating backoff - halting after max_consecutive_failures.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A failed rebalance never reports ACTIVE. If the close succeeds and the reopen fails,\nthe controller clears its position state, reports ERROR, and retries after an\nescalating backoff - halting after max_consecutive_failures.",
      "lineHeight": 1.25,
      "autoResize": true
    },
