      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Prices, not ticks.\nGateway and the Orca SDK align\nbounds to the pool's tick spacing;\nthe realized bounds are read back\nfrom the position.",
      "lineHeight": 1.25,
      "autoResize": true
    },
